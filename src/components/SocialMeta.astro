---
interface Props {
  title: string
  description: string
  canonical?: URL
  ogType?: 'website' | 'article'
  noindex?: boolean
}

const { title, description, canonical, ogType = 'website', noindex = false } = Astro.props
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
const image = new URL(`${baseUrl}riffle-social-preview.png`, Astro.site)
const imageAlt = 'riffle. — curated links'
---

<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="riffle." />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={image} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{canonical && <meta name="twitter:url" content={canonical} />}
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
