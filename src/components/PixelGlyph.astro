---
const pixels = [
  '0000000000000000',
  '0000011111100000',
  '0000100000010000',
  '0001000000001000',
  '0010001111000100',
  '0100010000100010',
  '0100100000010010',
  '0100100110010010',
  '0100100110010010',
  '0100100000010010',
  '0100010000100010',
  '0010001111000100',
  '0001000000001000',
  '0000100000010000',
  '0000011111100000',
  '0000000000000000',
]
---

<svg class="pixel-glyph" viewBox="0 0 16 16" role="img" aria-label="Riffle signal glyph">
  <title>Riffle signal glyph</title>
  {pixels.map((row, y) =>
    [...row].map((pixel, x) =>
      pixel === '1' ? <rect x={x} y={y} width="1" height="1" /> : null,
    ),
  )}
</svg>
