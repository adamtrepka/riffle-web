---
import PixelGlyph from '../../components/PixelGlyph.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  formatPublicationDate,
  getPrimaryUrl,
  loadIssues,
  type PublishedIssue,
} from '../../lib/issues'
import { canonicalizeResourceUrl, getResources } from '../../lib/resources/resources'

export function getStaticPaths() {
  return loadIssues().map((issue) => ({
    params: { slug: issue.slug },
    props: { issue },
  }))
}

const { issue } = Astro.props as { issue: PublishedIssue }
const description = issue.teaser
const resources = getResources()
const pathsByCanonicalUrl = new Map(resources.map((resource) => [resource.canonicalUrl, resource.path]))
---

<BaseLayout
  title={`${issue.title} — riffle.`}
  description={description}
  canonicalPath={`/issues/${issue.slug}/`}
  ogType="article"
>
  <main class="issue-page">
    <article>
      <header class="issue-header">
        <div>
          <p class="section-kicker">Issue / {formatPublicationDate(issue.generatedAt)}</p>
          <h1>{issue.title}</h1>
          <p class="teaser">{issue.teaser}</p>
          <p class="item-count">{issue.items.length} {issue.items.length === 1 ? 'link' : 'links'}</p>
        </div>
        <PixelGlyph />
      </header>

      <ol class="issue-items">
        {issue.items.map((item) => {
          const primaryUrl = getPrimaryUrl(item)
          const resourcePath = pathsByCanonicalUrl.get(canonicalizeResourceUrl(primaryUrl))
          if (!resourcePath) throw new Error(`No redirect route for resource ${primaryUrl}`)
          return (
            <li>
              <div class="item-meta">
                <span>r/{item.subreddit}</span>
              </div>
              <h2>
                <a class="item-title" href={resourcePath} target="_blank" rel="noreferrer">
                  {item.title} <span aria-hidden="true">↗</span>
                </a>
              </h2>
              <p class="item-description">{item.description}</p>
              <div class="item-links">
                {item.resourceUrl && (
                  <a
                    class="item-link"
                    href={resourcePath}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={`Resource for ${item.title} (opens in a new tab)`}
                  >
                    resource <span aria-hidden="true">↗</span>
                  </a>
                )}
                {item.redditUrl && (
                  <a
                    class="item-link"
                    href={item.redditUrl}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={`Discussion for ${item.title} (opens in a new tab)`}
                  >
                    discussion <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </li>
          )
        })}
      </ol>
    </article>
  </main>
</BaseLayout>
